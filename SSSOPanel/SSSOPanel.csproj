<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.4.0</Version>
		<RollForward>LatestMajor</RollForward>
		<NoWarn>$(NoWarn);ELECTRON001;CA1416</NoWarn>
	</PropertyGroup>

	<!-- ElectronNetCommon properties
	     ElectronNET.Core.props sets RuntimeIdentifier='win-x64' by default when unset.
	     Override that default on Unix so local dev and CI pick the host-matching RID.
	     Restore does not import package props, so the RID is still empty there and has to be
	     set as well, otherwise the assets file lacks the linux-x64 target (NETSDK1047).
	     Passing -r on the CLI still wins because global properties can't be overridden. -->
	<PropertyGroup Label="ElectronNetCommon">
		<RuntimeIdentifier Condition="('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'win-x64') AND '$(OS)' == 'Unix'">linux-x64</RuntimeIdentifier>
		<ElectronVersion>30.4.0</ElectronVersion>
		<ElectronSingleInstance>true</ElectronSingleInstance>
		<ElectronPackageId>com.spinshare.sssopanel</ElectronPackageId>
		<Title>SSSOPanel</Title>
		<!-- CircleLogo.png of the current event, from https://github.com/SpinShare/media (SSSO/V3/<Season><Year>) -->
		<ElectronIcon>electron/icon.png</ElectronIcon>
		<ElectronSplashScreen>electron/splashscreen.html</ElectronSplashScreen>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<!-- Kestrel: serves the overlay (OBS browser source) and its WebSocket -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ElectronNET.Core" Version="0.5.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Sentry" Version="3.33.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.0.1" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0-beta15" />
	</ItemGroup>

	<ItemGroup>
		<!-- Don't publish the UI source files, but do show them in the project files list -->
		<Content Remove="UserInterface/**" />
		<None Remove="UserInterface/**" />
		<None Include="UserInterface/**" Exclude="UserInterface/node_modules/**" />
		<None Remove="obj\**" />
		<None Remove=".github\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**" />
		<EmbeddedResource Remove="obj\**" />
		<EmbeddedResource Remove=".github\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="obj\**" />
		<Compile Remove=".github\**" />
	</ItemGroup>

	<!-- custom_main.js: loaded by Electron before .NET backend starts -->
	<ItemGroup>
		<None Update="electron\custom_main.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>.electron\custom_main.js</TargetPath>
		</None>
		<Content Include="preload.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- Panel window icon, ElectronIcon only ends up with electron-builder -->
		<Content Include="electron\icon.png">
			<Link>icon.png</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<!-- Voice bot (pharahp submodule) and the node runtime it runs on, next to the exe, never bundled -->
		<Content Include="VoiceBot\**" Exclude="VoiceBot\.git*;VoiceBot\.git\**;VoiceBot\.github\**;VoiceBot\.idea\**;VoiceBot\Dockerfile;VoiceBot\.dockerignore;VoiceBot\guild_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<Content Include="node\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<!-- Production UI: copy built frontend to output wwwroot/ -->
		<Content Include="Resources\wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

</Project>
